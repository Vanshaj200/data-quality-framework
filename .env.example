# Read access to the Berka data loaded by the sibling retail-banking-analytics project.
SOURCE_MYSQL_HOST=127.0.0.1
SOURCE_MYSQL_PORT=3306
SOURCE_MYSQL_DB=retail_banking
SOURCE_MYSQL_USER=dq_app
SOURCE_MYSQL_PASSWORD=change_me

# This project's own schema: rule definitions, dq_results, traceability.
DQ_MYSQL_DB=data_quality
DQ_MYSQL_USER=dq_app
DQ_MYSQL_PASSWORD=change_me

# Clearly-labelled copy of the 8 tables for the defect-injection script.
DEFECT_COPY_MYSQL_DB=dq_defect_copy
DEFECT_COPY_MYSQL_USER=dq_app
DEFECT_COPY_MYSQL_PASSWORD=change_me

# Dashboard reads data_quality only, read-only.
DASHBOARD_MYSQL_USER=dq_dashboard
DASHBOARD_MYSQL_PASSWORD=change_me
