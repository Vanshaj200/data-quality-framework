# For the deployed dashboard only (Streamlit Community Cloud). Local
# development doesn't need this file - dashboard.py falls back to .env.
#
# On share.streamlit.io: app settings -> Secrets -> paste this filled in
# with your cloud database's read-only credentials. Never commit the real
# secrets.toml (already gitignored).
DASHBOARD_MYSQL_HOST = "your-cloud-mysql-host"
DASHBOARD_MYSQL_PORT = 3306
DASHBOARD_MYSQL_USER = "a_readonly_user"
DASHBOARD_MYSQL_PASSWORD = "change_me"
DASHBOARD_MYSQL_DB = "your_database_name"
